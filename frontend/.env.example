# Base URL of the backend API. Leave this empty — the backend serves the built
# frontend, so requests go to /api/... on the same origin and work from any
# device that can reach the server.
#
# Setting an absolute URL here bakes that host into the bundle, which breaks
# access from every device except the one that built it. Only set it if you are
# deliberately running the API somewhere else.
VITE_API_BASE=
